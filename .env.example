# Copy this file to .env and fill in your real values.
# These are only used by `npm run dev` to prefill the app's local setup screen
# (they get written into this browser's localStorage, same as pasting them in
# by hand) — they are never bundled, built, or shipped anywhere.

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase → Project Settings → API → Publishable key (NOT the secret key —
# this app is client-side only, so the secret key must never go here; it
# would end up written to every visitor's browser localStorage)
SUPABASE_ANON_KEY=sb_publishable_...

# Clerk → API Keys → Publishable key
CLERK_PUBLISHABLE_KEY=pk_test_...
